{
  "expo": {
    "name": "Kinara",
    "slug": "project-connect",
    "version": "0.1.0",
    "scheme": "kinara",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#F7F4FF",
    "ios": {
      "bundleIdentifier": "com.projectconnect.app",
      "supportsTablet": false,
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Choose photos for your profile.",
        "NSCameraUsageDescription": "Take a profile photo or a verification selfie, and show your video in calls with your matches.",
        "ITSAppUsesNonExemptEncryption": false,
        "NSMicrophoneUsageDescription": "Let your matches hear you in voice and video calls."
      },
      "privacyManifests": {
        "NSPrivacyTracking": false,
        "NSPrivacyTrackingDomains": [],
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1"
            ]
          }
        ]
      }
    },
    "android": {
      "package": "com.projectconnect.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "monochromeImage": "./assets/adaptive-icon-mono.png",
        "backgroundColor": "#7B48CC"
      },
      "predictiveBackGestureEnabled": true,
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store",
      "expo-image",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#F7F4FF",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#16112A"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose photos for your profile.",
          "cameraPermission": "Take a profile photo or a verification selfie."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#7B48CC"
        }
      ],
      "expo-web-browser",
      "expo-sharing",
      "expo-iap",
      [
        "@config-plugins/react-native-webrtc",
        {
          "cameraPermission": "Take a profile photo or a verification selfie, and show your video in calls with your matches.",
          "microphonePermission": "Let your matches hear you in voice and video calls."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
