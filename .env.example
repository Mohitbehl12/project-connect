# Database. Local SQLite file for dev; a libsql://... Turso URL in production.
DATABASE_URL="file:./data/dev.db"
# Turso / libSQL auth token (production only)
DATABASE_AUTH_TOKEN=""

# Session signing secret — at least 32 random characters. Generate with: openssl rand -base64 48
AUTH_SECRET="replace-with-a-long-random-secret-at-least-32-chars"

# "true" shows OTP codes in API responses for local testing. MUST be "false" in production.
DEV_SHOW_OTP="true"

# Seeded super admin (change before first deploy)
SEED_ADMIN_EMAIL="admin@projectconnect.local"
SEED_ADMIN_PASSWORD="ChangeMe!2026"

# Test deployments only: lets the mock checkout activate plans without payment. Remove once Razorpay/Stripe is wired up.
ENABLE_MOCK_PAYMENTS="true"

# Push notifications through the Expo Push service (needs internet access from the server).
PUSH_ENABLED="false"

# Photo storage: "local" (default, data/uploads) or "s3" for Cloudflare R2 / AWS S3.
STORAGE_DRIVER="local"
# S3_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
# S3_BUCKET="project-connect-media"
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# S3_REGION="auto"

# --- Billing ---
# Public base URL of this server (used for pay links and invoice links).
APP_URL="http://localhost:3000"
# "mock" = test provider (no money moves; needs ENABLE_MOCK_PAYMENTS="true" in production builds), "razorpay" = live gateway.
BILLING_PROVIDER="mock"
# Razorpay keys from Dashboard → Settings → API Keys. Use test-mode keys first. Keep these in a secrets manager.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
# Dashboard → Webhooks: URL https://<your-domain>/api/webhooks/razorpay, choose a secret and paste it here.
RAZORPAY_WEBHOOK_SECRET=""
# Shared secret for the scheduled jobs endpoint (POST /api/cron/billing with header x-cron-secret). 32+ random chars.
CRON_SECRET=""

# --- Encryption at rest ---
# Comma-separated id:base64-32-byte keys; generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Required in production. To rotate: add a new key, set FIELD_KEY_ACTIVE to it, run npm run keys:rotate, then remove the old key.
FIELD_KEYS=""
FIELD_KEY_ACTIVE=""

# Email (password-reset links) via resend.com. Leave empty in development: links are logged / shown in test mode.
RESEND_API_KEY=""
EMAIL_FROM=""   # e.g. "Project Connect <no-reply@yourdomain.com>"

# In-app purchases (App Store / Google Play) — see docs/STORES.md
STORE_BILLING_ENABLED="false"
APPLE_BUNDLE_ID=""
APPLE_APP_ID=""            # numeric Apple ID of the app (App Store Connect → App Information)
APPLE_ROOT_CERTS_B64=""    # or put Apple root .cer files in certs/apple/
GOOGLE_PACKAGE_NAME=""
GOOGLE_SERVICE_ACCOUNT_JSON_B64=""
GOOGLE_RTDN_TOKEN=""       # long random string, also put in the Pub/Sub push URL

# SMS OTP through MSG91 (India; needs a DLT-approved OTP template)
MSG91_AUTH_KEY=""
MSG91_OTP_TEMPLATE_ID=""

# Database backups — see docs/DEPLOYMENT.md. Keep BACKUP_KEY somewhere safe offline.
BACKUP_KEY=""
BACKUP_DRIVER=""          # s3 (cloud storage, recommended) | dir (a folder; stopgap only)
BACKUP_DIR=""
BACKUP_S3_BUCKET=""       # optional: a separate bucket from the photos
BACKUP_EVERY_HOURS="6"
BACKUP_KEEP_DAYS="30"

# Automatic photo checks (sightengine.com). Without them, production photos wait for staff review.
SIGHTENGINE_USER=""
SIGHTENGINE_SECRET=""
