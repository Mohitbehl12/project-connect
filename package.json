{
  "name": "project-connect",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "db:push": "drizzle-kit push --force",
    "db:seed": "tsx scripts/seed.ts",
    "db:reset": "tsx scripts/reset.ts && drizzle-kit push --force && tsx scripts/seed.ts && tsx scripts/seed-photos.ts && tsx scripts/rotate-keys.ts",
    "test": "vitest run",
    "test:e2e": "tsx tests/e2e.ts",
    "typecheck": "tsc --noEmit",
    "db:seed-photos": "tsx scripts/seed-photos.ts",
    "keys:rotate": "tsx scripts/rotate-keys.ts",
    "db:remove-samples": "tsx scripts/remove-samples.ts",
    "build:all": "npm run build:app-web && next build",
    "build:app-web": "cd mobile && EXPO_BASE_URL=/app EXPO_PUBLIC_API_URL= npx expo export --platform web --output-dir ../public/app",
    "start:server": "tsx scripts/migrate.ts && tsx scripts/seed-if-empty.ts && next start -H 0.0.0.0",
    "db:migrate": "tsx scripts/migrate.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
