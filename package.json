    "@libsql/client": "^0.18.0",
    "@node-rs/argon2": "^2.2.2",
    "bcryptjs": "^3.0.3",
    "blurhash": "^2.0.5",
    "drizzle-orm": "^0.45.4",
    "jose": "^6.2.12",
    "next": "^15.5.27",
    "pdf-lib": "^1.17.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.5"
  },
